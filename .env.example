# Optional: enables WalletConnect (mobile / QR-code wallet connection) in
# ConnectWalletButton, alongside the browser-injected-wallet connector that
# already works with no config. Get a project id at https://cloud.reown.com
# — an empty/fake value here just fails silently, so it's left blank rather
# than filled with a placeholder that looks real.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Not yet used anywhere in the codebase. Aark Digital doesn't publish a
# public API/SDK — these are placeholders for whatever their real
# integration turns out to need (a partner API base URL, a session-key
# registry contract address, etc.) once that's known. See README.md,
# "Aark Digital integration status".
# NEXT_PUBLIC_AARK_API_URL=
# NEXT_PUBLIC_AARK_SESSION_KEY_REGISTRY_ADDRESS=
